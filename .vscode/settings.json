{
  // TypeScript 7 (Go port) ships no tsserver.js, so the classic `typescript.tsdk` can't point at it; the
  // TypeScript 7 extension (see extensions.json) keeps editor diagnostics in line with `pnpm -C packages/cli typecheck`.
  // Keep the path relative: accepting the extension's workspace-version prompt rewrites it as an absolute path.
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "packages/cli/node_modules/typescript",

  // Generated by `ap` from the preset (CLAUDE.md > Gotchas): change the preset and run `pnpm ap sync` instead.
  "files.readonlyInclude": {
    "agent-plugins.lock": true,
    ".claude/settings.json": true
  },

  // Committed lockfiles. Gitignored build output (dist/, release/) is already skipped via `search.useIgnoreFiles`.
  "search.exclude": {
    "**/agent-plugins.lock": true,
    "pnpm-lock.yaml": true
  }
}
