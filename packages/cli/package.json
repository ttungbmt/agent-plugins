{
  "name": "agent-plugins",
  "version": "0.1.0",
  "description": "CLI `ap`: khai báo marketplace, plugin, skill, agent và MCP server cho Claude Code bằng YAML rồi đồng bộ vào settings",
  "type": "module",
  "bin": {
    "ap": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "presets"
  ],
  "engines": {
    "node": ">=22"
  },
  "oclif": {
    "bin": "ap",
    "dirname": "ap",
    "commands": {
      "strategy": "explicit",
      "target": "./dist/commands/index.js",
      "identifier": "COMMANDS"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/copy-presets.mjs && tsc -p tsconfig.build.json",
    "pack:release": "pnpm build && node scripts/pack-release.mjs"
  },
  "devDependencies": {
    "@oclif/core": "^5.0.0",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "cli-progress": "^3.12.0",
    "esbuild": "^0.28.2",
    "ink": "^7.1.1",
    "listr2": "^11.1.0",
    "presets": "workspace:*",
    "react": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
