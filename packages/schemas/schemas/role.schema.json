{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-plugins.dev/schemas/profile.schema.json",
  "title": "Profile",
  "description": "A role baseline. A Profile reaches Capabilities through Presets (domain-model.md:743-790).",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/definitions/apiVersion"},
    "kind": {"const": "Profile"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"$ref": "common.schema.json#/definitions/kebabId"},
        "name": {"$ref": "common.schema.json#/definitions/nonEmptyString"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "presets"],
      "properties": {
        "description": {"$ref": "common.schema.json#/definitions/nonEmptyString"},
        "presets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/definitions/presetId"}
        }
      }
    }
  }
}
