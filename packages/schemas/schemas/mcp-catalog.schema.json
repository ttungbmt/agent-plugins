{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp-catalog.schema.json",
  "title": "ap MCP catalog",
  "description": "The MCP catalog shipped with `ap`: server configurations a Preset or Config enables with `name: true` under `spec.mcpServers`.",
  "type": "object",
  "required": ["kind", "servers"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "McpCatalog" },
    "servers": {
      "type": "object",
      "propertyNames": { "$ref": "preset.schema.json#/$defs/name" },
      "additionalProperties": { "$ref": "preset.schema.json#/$defs/mcpServer" }
    }
  }
}
