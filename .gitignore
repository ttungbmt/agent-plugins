# Dependencies
node_modules/
.pnpm-store/

# Generated build output. dist/ is disposable; never edit it to change behavior.
dist/*
!dist/.gitkeep

# Secrets and machine-local state. Collection alias mappings and absolute
# checkout paths never get committed.
.env
.env.*
!.env.example
*.local

# Logs and diagnostics
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Test and coverage output
coverage/
*.lcov
.nyc_output/

# Caches
.cache/
.eslintcache
*.tsbuildinfo

# Editor and OS
.idea/
.vscode/
.DS_Store
